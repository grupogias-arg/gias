# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key


# Project additions (from the original gitignore in this repo).
/node_modules
/config/credentials/*.key
.DS_Store

# Fotos de ejemplo para los seeds: material pesado y sin aprobar del grupo.
# Se versiona solo el README con la convención de nombres.
/db/seeds/images/**/*
!/db/seeds/images/README.md

/app/assets/builds/*
!/app/assets/builds/.keep

# Fotos de portada de ejemplo que los seeds copian desde db/seeds/images/.
/app/assets/images/portada/

# El logo SÍ se versiona: desde que llegó el material del grupo, logo.png y
# logo-sintesis.png son la marca aprobada del "Manual de marca GIAS" (2021),
# no un placeholder. Pesan 71 KB entre los dos.

# Copia local de la carpeta "Contenido para web" del Drive del grupo.
# Material pesado y sin aprobar: se consulta, no se versiona.
/drive/
