<% content_for :title, t("contacto.title") %>
<% content_for :description, t("contacto.subtitle") %>

<%= render "shared/page_header",
           label: t("nav.contacto"),
           title: t("contacto.title"),
           subtitle: t("contacto.subtitle") %>

<div class="wrap grid gap-10 py-10 sm:py-14 lg:grid-cols-2 lg:gap-16">
  <div>
    <p class="max-w-[56ch] text-[16.5px]"><%= t("contacto.invitacion") %></p>

    <% email = Rails.application.config.site[:email] %>
    <% if email.present? %>
      <div class="mt-8">
        <p class="lbl"><%= t("contacto.email") %></p>
        <%= link_to email, "mailto:#{email}", class: "mt-1 inline-block text-[17px] text-accent hover:underline" %>
      </div>
    <% end %>

    <%# Redes: se muestran solo las que el grupo ya pasó (config/site.yml). %>
    <% redes = %i[instagram facebook cerzos researchgate]
                 .index_with { |red| Rails.application.config.site[red] }
                 .compact_blank %>
    <% if redes.any? %>
      <div class="mt-8">
        <p class="lbl"><%= t("contacto.redes") %></p>
        <div class="mt-2 flex flex-wrap gap-x-5 gap-y-2">
          <% redes.each do |red, url| %>
            <%= link_to t("contacto.#{red}"), url,
                        class: "font-mono text-[11px] uppercase tracking-[0.1em] text-accent hover:underline",
                        **new_tab %>
          <% end %>
        </div>
      </div>
    <% else %>
      <div class="mt-8">
        <p class="lbl"><%= t("contacto.redes") %></p>
        <p class="mt-2 font-mono text-[10.5px] uppercase tracking-[0.12em] text-ink-soft">
          <%= t("comun.pendiente") %>
        </p>
      </div>
    <% end %>
  </div>

  <div>
    <p class="lbl"><%= t("contacto.direccion") %></p>
    <div class="mt-3 space-y-4 text-[15px]">
      <p><%= t("contacto.sede_cerzos") %></p>
      <p><%= t("contacto.sede_agro") %></p>
    </div>
  </div>
</div>
