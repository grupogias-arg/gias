<%#
  Home con las 8 secciones en scroll largo, en el orden que definió el grupo:
  Portada · Novedades · Equipo · Publicaciones · Proyectos · Campañas ·
  Divulgación · Contacto (CLAUDE.md — no reordenar).

  Cada sección muestra un adelanto y enlaza a su página propia: lo que crece
  no vive solo dentro de un ancla.
%>
<% content_for :description, t("home.hero_title") %>

<%# ── Portada ─────────────────────────────────────────────────────────── %>
<%#
  Logo fijo y fotos que rotan al lado (docs/pedido.md; el grupo mandó un
  ejemplo de cómo se lo imaginan). En celular el logo va arriba y la foto
  abajo; desde lg, uno al lado del otro.

  El logo entero es la marca completa que el manual pide ver en la página
  (p.10), además de la del pie. Es el <h1>: el nombre está dentro de la imagen
  y el manual prohíbe re-tipografiarlo, así que va en el alt.

  Las fotos son de estudio, sobre fondo blanco. `mix-blend-multiply` funde
  ese blanco con el papel. Va en el div de cada slide y no en el <img>: el
  div tiene opacidad (el fundido), y eso aísla al <img> del fondo.
%>
<% fotos = @cover_photos %>

<section id="portada" class="border-b border-hairline bg-paper"
         data-controller="carousel">
  <div class="wrap grid items-center gap-4 py-8 sm:gap-6 sm:py-14 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:gap-14 lg:py-16">
    <h1>
      <%= image_tag "logo.png", alt: t("site.full_name"), width: 1285, height: 602,
                    fetchpriority: "high",
                    class: "mx-auto h-auto w-full max-w-[400px] lg:max-w-none" %>
    </h1>

    <% if fotos.any? %>
      <div>
        <div class="relative aspect-[4/3]">
          <% fotos.each_with_index do |foto, index| %>
            <%#
              Solo la primera se muestra de entrada. Las otras arrancan con
              `hidden`, y un <img loading="lazy"> oculto no se descarga: el
              controller destapa la que sigue un turno antes de mostrarla.
              Así el celular no baja todas las fotos de golpe.
            %>
            <div class="absolute inset-0 mix-blend-multiply transition-opacity duration-700 <%= index.zero? ? "opacity-100" : "hidden opacity-0" %>"
                 data-carousel-target="slide">
              <%= responsive_image_tag foto.image, widths: ApplicationHelper::WIDE_VARIANT_WIDTHS,
                                       sizes: "(min-width: 1024px) 55vw, calc(100vw - 32px)",
                                       alt: "", loading: (index.zero? ? "eager" : "lazy"),
                                       class: "h-full w-full object-contain" %>
            </div>
          <% end %>
        </div>

        <% if fotos.size > 1 %>
          <div class="mt-3 flex flex-wrap justify-center gap-1">
            <% fotos.each_with_index do |_foto, index| %>
              <%# El área de toque es más grande que la rayita que se ve. %>
              <button type="button"
                      class="group cursor-pointer px-0.5 py-2"
                      data-carousel-target="dot"
                      data-index="<%= index %>"
                      data-action="carousel#goTo"
                      aria-current="<%= index.zero? %>"
                      aria-label="<%= t("home.foto_n", n: index + 1) %>">
                <span class="block h-1 w-3 bg-hairline sm:w-4 group-hover:bg-ink-soft group-aria-[current=true]:bg-structure"></span>
              </button>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</section>

<%# ── Bienvenida ──────────────────────────────────────────────────────── %>
<section class="band">
  <div class="wrap grid gap-8 lg:grid-cols-[1fr_320px] lg:gap-14">
    <div>
      <p class="lbl"><%= t("home.intro_label") %></p>
      <h2 class="mt-2 font-serif text-[26px] font-light leading-[1.12] tracking-[-0.018em] sm:text-[32px]">
        <%= t("home.intro_title") %>
      </h2>
      <p class="mt-5 max-w-[66ch] text-[16.5px]"><%= t("home.intro_body") %></p>
      <p class="mt-4 max-w-[66ch] text-[16.5px] text-ink-soft"><%= t("home.intro_body_2") %></p>
    </div>

    <%#
      Dos fotos de campo al lado de la presentación. Las de estudio ya rotan
      en la portada; acá van las campañas, que muestran dónde se trabaja.
    %>
    <div class="grid grid-cols-2 gap-3 lg:grid-cols-1">
      <% @intro_photos.each do |foto| %>
        <%= responsive_image_tag foto, widths: ApplicationHelper::WIDE_VARIANT_WIDTHS,
                                 sizes: "(min-width: 1024px) 320px, 50vw",
                                 alt: "", class: "aspect-[4/3] w-full border border-hairline object-cover" %>
      <% end %>
      <% (2 - @intro_photos.size).times do %>
        <%= photo_placeholder css_class: "aspect-[4/3] w-full" %>
      <% end %>
    </div>
  </div>
</section>

<%# ── Novedades ───────────────────────────────────────────────────────── %>
<section id="novedades" class="band border-t border-hairline">
  <div class="wrap">
    <%= render "shared/section_header",
               label: t("nav.novedades"),
               title: t("novedades.title"),
               subtitle: t("novedades.subtitle"),
               link: posts_path,
               link_label: t("novedades.ver_todas") %>

    <div class="mt-8">
      <% if @posts.any? %>
        <%= render @posts %>
      <% else %>
        <%= render "shared/empty", message: t("novedades.sin_publicar") %>
      <% end %>
    </div>
  </div>
</section>

<%# ── Equipo ──────────────────────────────────────────────────────────── %>
<section id="equipo" class="band border-t border-hairline bg-paper-2/50">
  <div class="wrap">
    <%= render "shared/section_header",
               label: t("nav.equipo"),
               title: t("equipo.title"),
               subtitle: t("equipo.subtitle"),
               link: members_path,
               link_label: t("equipo.ver_todo") %>

    <div class="mt-8">
      <% if @members.any? %>
        <%= render @members %>
      <% else %>
        <%= render "shared/empty", message: t("equipo.sin_integrantes") %>
      <% end %>
    </div>
  </div>
</section>

<%# ── Publicaciones ───────────────────────────────────────────────────── %>
<section id="publicaciones" class="band border-t border-hairline">
  <div class="wrap">
    <%= render "shared/section_header",
               label: t("nav.publicaciones"),
               title: t("publicaciones.title"),
               subtitle: t("publicaciones.subtitle"),
               link: publications_path,
               link_label: t("publicaciones.ver_todas") %>

    <div class="mt-8">
      <% if @publications.any? %>
        <%= render @publications %>
      <% else %>
        <%= render "shared/empty", message: t("publicaciones.sin_publicaciones") %>
      <% end %>
    </div>
  </div>
</section>

<%# ── Proyectos ───────────────────────────────────────────────────────── %>
<section id="proyectos" class="band border-t border-hairline bg-paper-2/50">
  <div class="wrap">
    <%= render "shared/section_header",
               label: t("nav.proyectos"),
               title: t("proyectos.title"),
               subtitle: t("proyectos.subtitle"),
               link: projects_path,
               link_label: t("proyectos.ver_todos") %>

    <div class="mt-8">
      <% if @projects.any? %>
        <%= render @projects %>
      <% else %>
        <%= render "shared/empty", message: t("proyectos.sin_proyectos") %>
      <% end %>
    </div>
  </div>
</section>

<%# ── Campañas ────────────────────────────────────────────────────────── %>
<section id="campanas" class="band border-t border-hairline">
  <div class="wrap">
    <%= render "shared/section_header",
               label: t("nav.campanas"),
               title: t("campanas.title"),
               subtitle: t("campanas.subtitle"),
               link: campaigns_path,
               link_label: t("campanas.ver_todas") %>

    <div class="mt-8 grid gap-10 lg:grid-cols-[1fr_420px]">
      <div>
        <% if @campaigns.any? %>
          <%= render @campaigns %>
        <% else %>
          <%= render "shared/empty", message: t("campanas.sin_campanas") %>
        <% end %>
      </div>

      <%= render "campaigns/map", campaigns: @mapped_campaigns %>
    </div>
  </div>
</section>

<%# ── Divulgación ─────────────────────────────────────────────────────── %>
<section id="divulgacion" class="band border-t border-hairline bg-paper-2/50">
  <div class="wrap">
    <%= render "shared/section_header",
               label: t("nav.divulgacion"),
               title: t("divulgacion.title"),
               subtitle: t("divulgacion.subtitle"),
               link: outreach_items_path,
               link_label: t("divulgacion.ver_todo") %>

    <% videos = @outreach_items.select(&:embedded_video?).first(2) %>
    <% materiales = @outreach_items.reject(&:embedded_video?) %>

    <div class="mt-8">
      <% if @outreach_items.any? %>
        <% if videos.any? %>
          <div class="grid gap-6 sm:grid-cols-2">
            <% videos.each do |item| %>
              <%= render "outreach_items/video", item: item %>
            <% end %>
          </div>
        <% end %>

        <% if materiales.any? %>
          <div class="mt-10">
            <p class="lbl mb-2"><%= t("divulgacion.materiales") %></p>
            <%= render materiales %>
          </div>
        <% end %>
      <% else %>
        <%= render "shared/empty", message: t("divulgacion.sin_material") %>
      <% end %>
    </div>
  </div>
</section>

<%# ── Contacto ────────────────────────────────────────────────────────── %>
<section id="contacto" class="band border-t border-hairline bg-accent text-paper">
  <div class="wrap">
    <p class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-paper/70"><%= t("nav.contacto") %></p>
    <h2 class="mt-2 font-serif text-[28px] font-light leading-[1.12] tracking-[-0.018em] sm:text-[36px]">
      <%= t("contacto.subtitle") %>
    </h2>
    <p class="mt-4 max-w-[58ch] text-[16.5px] text-paper/85"><%= t("contacto.invitacion") %></p>

    <%= link_to t("contacto.title"), contact_path,
                class: "mt-6 inline-block border border-paper/60 px-5 py-2.5 font-mono text-[11px] uppercase tracking-[0.11em] hover:bg-paper hover:text-accent",
                **new_tab %>
  </div>
</section>
