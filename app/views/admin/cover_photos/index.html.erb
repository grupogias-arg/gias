<% content_for :title, "Portada" %>

<div>
  <p class="lbl">Panel</p>
  <h1 class="mt-1 font-serif text-[32px] font-light leading-tight">Portada</h1>
  <p class="mt-2 max-w-[62ch] text-ink-soft">
    Las fotos que van pasando al lado del logo, en este orden. Cambian solas cada
    3 segundos. Funcionan mejor las fotos de la araña sola sobre fondo blanco:
    el blanco se funde con el fondo del sitio.
  </p>
</div>

<%= form_with model: CoverPhoto.new, url: admin_cover_photos_path, class: "admin-fieldset mt-8 max-w-3xl" do |form| %>
  <%= admin_field form, :images, label: "Agregar fotos",
                  hint: "Podés elegir varias a la vez. No hace falta achicarlas: el sitio arma versiones livianas para el celular." do %>
    <%= form.file_field :images, multiple: true, direct_upload: true, accept: "image/jpeg,image/png,image/webp",
                        class: "admin-input text-[14.5px]" %>
  <% end %>

  <%= form.submit "Subir", class: "admin-button-primary mt-4" %>
<% end %>

<% if @cover_photos.empty? %>
  <p class="mt-10 text-ink-soft">Todavía no hay fotos. La portada muestra solo el logo.</p>
<% else %>
  <ol class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
    <% @cover_photos.each_with_index do |photo, index| %>
      <li class="border border-hairline bg-paper-2/40 p-3">
        <div class="flex items-center justify-between">
          <span class="font-mono text-[10.5px] uppercase tracking-[0.1em] text-ink-soft">
            <%= index.zero? ? "1 · la primera" : index + 1 %>
          </span>
        </div>

        <div class="mt-2 bg-paper">
          <%= responsive_image_tag photo.image, widths: ApplicationHelper::WIDE_VARIANT_WIDTHS,
                                   sizes: "(min-width: 1024px) 25vw, (min-width: 640px) 33vw, 50vw",
                                   alt: photo.image.filename.to_s,
                                   class: "aspect-[4/3] w-full object-contain mix-blend-multiply" %>
        </div>

        <div class="mt-3 flex flex-wrap gap-1.5">
          <% unless index.zero? %>
            <%= button_to "← Antes", move_admin_cover_photo_path(photo, direction: "antes"), method: :patch,
                          class: "admin-button cursor-pointer px-2 py-1 text-[12.5px]" %>
          <% end %>
          <% unless index == @cover_photos.size - 1 %>
            <%= button_to "Después →", move_admin_cover_photo_path(photo, direction: "despues"), method: :patch,
                          class: "admin-button cursor-pointer px-2 py-1 text-[12.5px]" %>
          <% end %>
          <%= button_to "Sacar", admin_cover_photo_path(photo), method: :delete,
                        class: "cursor-pointer px-2 py-1 text-[12.5px] text-ink-soft hover:text-vino",
                        form: { data: { turbo_confirm: "La foto deja de aparecer en la portada. ¿Seguimos?" } } %>
        </div>
      </li>
    <% end %>
  </ol>
<% end %>
