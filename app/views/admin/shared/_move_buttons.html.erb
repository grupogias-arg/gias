<%# Flechas para cambiar el orden en un listado (ver Admin::Reorderable). %>
<% unless first %>
  <%= button_to "↑", path.call("antes"), method: :patch, title: "Subir",
                class: "admin-button cursor-pointer px-2.5 py-1.5 text-[13.5px]", form: { class: "inline" } %>
<% end %>
<% unless last %>
  <%= button_to "↓", path.call("despues"), method: :patch, title: "Bajar",
                class: "admin-button cursor-pointer px-2.5 py-1.5 text-[13.5px]", form: { class: "inline" } %>
<% end %>
