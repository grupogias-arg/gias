<% content_for :title, "Editar: #{@member.name_in_database}" %>

<div class="max-w-3xl">
  <%= link_to "← Equipo", admin_members_path, class: "font-mono text-[10.5px] uppercase tracking-[0.11em] text-accent hover:underline" %>
  <h1 class="mt-3 mb-8 font-serif text-[32px] font-light leading-tight"><%= @member.name_in_database %></h1>

  <%= render "form", member: @member %>

  <%= render "admin/shared/destroy", label: "Sacar del equipo", name: @member.name_in_database,
             hint: "Deja de aparecer en el sitio y se borra su foto.",
             path: admin_member_path(@member) %>
</div>
