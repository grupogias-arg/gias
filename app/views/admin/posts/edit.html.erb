<% content_for :title, "Editar: #{@post.title_in_database}" %>

<div class="max-w-3xl">
  <%= link_to "← Novedades", admin_posts_path, class: "font-mono text-[10.5px] uppercase tracking-[0.11em] text-accent hover:underline" %>
  <div class="mt-3 mb-8 flex flex-wrap items-center gap-3">
    <h1 class="font-serif text-[32px] font-light leading-tight"><%= @post.title_in_database %></h1>
    <%= post_status_badge(@post) %>
  </div>

  <%= render "form", post: @post %>

  <div class="admin-fieldset mt-16">
    <p class="admin-label">Borrar la novedad</p>
    <p class="admin-hint">Se borra del sitio y del panel, con sus fotos y adjuntos. No se puede deshacer.</p>
    <%= button_to "Borrar", admin_post_path(@post.id), method: :delete,
                  class: "admin-button mt-3 border-vino text-vino hover:bg-vino hover:text-paper",
                  form: { data: { turbo_confirm: "¿Borrar «#{@post.title_in_database}»? No se puede deshacer." } } %>
  </div>
</div>
