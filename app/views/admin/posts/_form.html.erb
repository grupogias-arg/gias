<%#
  Formulario de una novedad. Lo usa gente no técnica: cada campo dice qué va
  y qué pasa si queda vacío.

  La URL va por id y no por el modelo: Post#to_param devuelve el slug, que se
  puede estar editando en este mismo formulario (ver config/routes.rb).
%>
<% publicada = post.persisted? && post.published_at_in_database.present? %>

<%= form_with model: post, url: (post.new_record? ? admin_posts_path : admin_post_path(post.id)) do |form| %>
  <% if post.errors.any? %>
    <div class="mb-8 border-l-2 border-vino bg-paper-2 px-4 py-3" role="alert">
      <p class="font-semibold text-vino"><%= t("errors.template.header", count: post.errors.count) %></p>
      <ul class="mt-1 list-disc pl-5 text-[14.5px]">
        <% post.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= admin_field form, :kind, hint: "Ordena las novedades por tema. Se muestra como etiqueta arriba del título." do %>
    <%= form.select :kind, Post::KINDS.map { |kind| [ t("enums.post.kind.#{kind}"), kind ] }, {}, class: "admin-input" %>
  <% end %>

  <%= admin_field form, :title do %>
    <%= form.text_field :title, class: "admin-input", required: true %>
  <% end %>

  <%= admin_field form, :excerpt,
                  hint: "Una o dos oraciones. Es lo que aparece en el listado de novedades y en la vista previa cuando se comparte el link por WhatsApp." do %>
    <%= form.text_area :excerpt, rows: 3, class: "admin-input" %>
  <% end %>

  <%= admin_field form, :body,
                  hint: "Podés pegar desde Word: se limpia el formato raro y quedan negritas, cursivas, listas y links. Las fotos se arrastran adentro del texto. Los nombres de especies se ponen en cursiva solos." do %>
    <div data-controller="word-paste" data-action="trix-before-paste->word-paste#clean">
      <%= form.rich_textarea :body %>
    </div>
  <% end %>

  <details class="admin-fieldset group" <%= "open" if post.title_en.present? || post.errors.any? { |e| e.attribute.to_s.end_with?("_en") } %>>
    <summary class="cursor-pointer list-none">
      <span class="admin-label inline">En inglés <span class="font-normal text-ink-soft">(opcional)</span></span>
      <span class="ml-1 text-ink-soft group-open:hidden">▸ Abrir</span>
      <span class="ml-1 hidden text-ink-soft group-open:inline">▾ Cerrar</span>
      <p class="admin-hint">Lo que quede vacío se muestra en español en la versión en inglés del sitio.</p>
    </summary>

    <div class="mt-6">
      <%= admin_field form, :title_en do %>
        <%= form.text_field :title_en, class: "admin-input" %>
      <% end %>

      <%= admin_field form, :excerpt_en do %>
        <%= form.text_area :excerpt_en, rows: 3, class: "admin-input" %>
      <% end %>

      <%= admin_field form, :body_en do %>
        <div data-controller="word-paste" data-action="trix-before-paste->word-paste#clean">
          <%= form.rich_textarea :body_en %>
        </div>
      <% end %>
    </div>
  </details>

  <div class="admin-fieldset">
    <%= admin_field form, :documents,
                    hint: "PDF para descargar al pie de la nota (por ejemplo, el artículo completo). El texto de la nota va arriba, no en el PDF: un PDF no se lee bien en el celular." do %>
      <%# Sin este campo vacío, destildar todos los adjuntos no borraría ninguno. %>
      <%= hidden_field_tag "post[documents][]", "", id: nil %>

      <% if post.documents.any? %>
        <ul class="mt-3 space-y-2">
          <% post.documents.each do |document| %>
            <li>
              <label class="flex items-center gap-2 text-[15px]">
                <%= check_box_tag "post[documents][]", document.signed_id, true, id: nil, class: "size-4 accent-structure" %>
                <%= document.filename %>
                <span class="font-mono text-[10.5px] text-ink-soft">(<%= number_to_human_size(document.byte_size) %>)</span>
              </label>
            </li>
          <% end %>
        </ul>
        <p class="admin-hint mt-2">Destildá un archivo para sacarlo de la nota.</p>
      <% end %>

      <%= form.file_field :documents, multiple: true, direct_upload: true, accept: "application/pdf",
                          class: "admin-input text-[14.5px]" %>
    <% end %>
  </div>

  <div class="admin-fieldset">
    <%= admin_field form, :published_at,
                    hint: "Vacía: se publica con la fecha de hoy. Una fecha pasada sirve para cargar notas viejas; una futura deja la nota programada y aparece sola ese día." do %>
      <%= form.date_field :published_at, class: "admin-input sm:w-60" %>
    <% end %>

    <% if publicada %>
      <div class="admin-field">
        <p class="admin-label">Dirección web</p>
        <p class="admin-hint">Ya está publicada, así que no se puede cambiar: si alguien compartió el link, dejaría de andar.</p>
        <p class="mt-2 break-all font-mono text-[13px]"><%= post_url(slug: post.slug_in_database) %></p>
      </div>
    <% else %>
      <%= admin_field form, :slug,
                      hint: "Es la última parte del link de la nota. Si la dejás vacía se arma sola con el título. Solo minúsculas, números y guiones. Una vez publicada ya no se puede cambiar." do %>
        <%= form.text_field :slug, class: "admin-input font-mono", placeholder: "se-arma-sola-con-el-titulo" %>
      <% end %>
    <% end %>
  </div>

  <div class="admin-fieldset flex flex-col gap-3 sm:flex-row">
    <% if publicada %>
      <%= form.button "Guardar cambios", name: "estado", value: "publicada", class: "admin-button-primary" %>
      <%= form.button "Volver a borrador", name: "estado", value: "borrador", class: "admin-button",
                      data: { turbo_confirm: "La nota deja de verse en el sitio hasta que la publiques de nuevo. ¿Seguimos?" } %>
    <% else %>
      <%= form.button "Publicar", name: "estado", value: "publicada", class: "admin-button-primary" %>
      <%= form.button "Guardar como borrador", name: "estado", value: "borrador", class: "admin-button" %>
    <% end %>
    <%= link_to "Cancelar", admin_posts_path, class: "px-2 py-3 text-[15px] text-ink-soft hover:text-accent sm:ml-auto" %>
  </div>
<% end %>
