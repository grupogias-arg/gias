<% content_for :title, "Ingresar" %>

<div class="mx-auto max-w-sm pt-6 sm:pt-12">
  <%= image_tag "logo.png", alt: t("site.name"), width: 1285, height: 602, class: "mx-auto h-[56px] w-auto" %>

  <h1 class="mt-8 text-center font-serif text-[28px] font-light">Panel de carga</h1>

  <%= form_with url: admin_session_path, class: "mt-8 space-y-5" do |form| %>
    <div>
      <%= form.label :email_address, "Correo electrónico", class: "admin-label" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
                           value: params[:email_address], class: "admin-input" %>
    </div>

    <div>
      <%= form.label :password, "Contraseña", class: "admin-label" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password",
                              maxlength: 72, class: "admin-input" %>
    </div>

    <%= form.submit "Ingresar", class: "admin-button-primary w-full" %>
  <% end %>

  <p class="mt-6 text-center text-[13.5px] text-ink-soft">
    ¿Te olvidaste la contraseña? Pedile a quien administra el sitio que te la cambie.
  </p>
</div>
