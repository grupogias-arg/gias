<%#
  Campaña: tres fotos y descripción. El id es el destino al
  que salta el mapa cuando se toca el punto correspondiente.
%>
<article id="campana-<%= campaign.id %>" class="scroll-mt-[calc(61px+16px)] border-t border-hairline py-6">
  <p class="lbl">
    <%= [ campaign.locality, campaign.province ].compact_blank.join(" · ") %>
  </p>

  <h3 class="mt-1 font-serif text-[20px] font-light leading-snug tracking-[-0.012em]">
    <%= campaign.localized_name %>
  </h3>

  <p class="mt-1 font-mono text-[11px] tracking-[0.08em] text-ink-soft">
    <%#
      La mayoría de las campañas vino fechada solo por año, y varias abarcan un
      rango. Si alguna tiene fecha exacta cargada, gana esa.
    %>
    <% if campaign.date.present? %>
      <%= long_date(campaign.date) %>
    <% elsif campaign.year_start.present? %>
      <%= campaign.multi_year? ? "#{campaign.year_start}–#{campaign.year_end}" : campaign.year_start %>
    <% end %>
    <%= " · #{t('campanas.dias', count: campaign.days)}" if campaign.days.present? %>
  </p>

  <% if campaign.localized_description.present? %>
    <p class="mt-3 max-w-[62ch] text-[15px] text-ink-soft"><%= campaign.localized_description %></p>
  <% end %>

  <%#
    En celular la primera foto va a lo ancho y las otras dos abajo: tres
    columnas a 375px dejan fotos de 110px.
  %>
  <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3">
    <% photos = campaign.photos.to_a.first(Campaign::EXPECTED_PHOTOS) %>
    <% Campaign::EXPECTED_PHOTOS.times do |index| %>
      <% photo = photos[index] %>
      <% if photo %>
        <%= responsive_image_tag photo,
                                 sizes: index.zero? ? "(min-width: 1024px) 250px, (min-width: 640px) 30vw, 100vw" : "(min-width: 1024px) 250px, (min-width: 640px) 30vw, 45vw",
                                 widths: ApplicationHelper::WIDE_VARIANT_WIDTHS,
                                 alt: campaign.localized_name,
                                 class: class_names("aspect-[4/3] w-full border border-hairline object-cover", "col-span-2 sm:col-span-1": index.zero?) %>
      <% else %>
        <%= photo_placeholder css_class: class_names("aspect-[4/3] w-full", "col-span-2 sm:col-span-1": index.zero?) %>
      <% end %>
    <% end %>
  </div>
</article>
