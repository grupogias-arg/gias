<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= [ content_for(:title), t("site.name") ].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for(:description) || t("site.tagline") %>">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= t("site.name") %>">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Las novedades se comparten sobre todo por WhatsApp: la tarjeta del link importa. %>
    <meta property="og:site_name" content="<%= t("site.name") %>">
    <meta property="og:title" content="<%= content_for(:title) || t("site.tagline") %>">
    <meta property="og:description" content="<%= content_for(:description) || t("site.tagline") %>">
    <meta property="og:type" content="website">
    <meta property="og:locale" content="<%= I18n.locale == :en ? "en_US" : "es_AR" %>">

    <%# El mismo contenido en los dos idiomas: que el buscador sepa cuál es cuál. %>
    <link rel="alternate" hreflang="es" href="<%= locale_switch_url(:es) %>">
    <link rel="alternate" hreflang="en" href="<%= locale_switch_url(:en) %>">

    <%# El feed reemplaza a la suscripción por mail, que quedó para la etapa 2
        (CLAUDE.md). Va solo acá, sin link visible: quien no conoce RSS y hace
        clic ve un XML crudo y parece un error. Los lectores de RSS lo
        encuentran igual a partir de esta etiqueta. %>
    <%= auto_discovery_link_tag :rss, posts_url(format: :rss), title: "#{t("site.name")} — #{t("novedades.title")}" %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,200;0,6..72,300;0,6..72,400;1,6..72,300;1,6..72,400&family=Karla:wght@400;500;600&family=Azeret+Mono:wght@400;500&display=swap" rel="stylesheet">

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-paper text-ink">
    <a href="#contenido"
       class="sr-only focus:not-sr-only focus:absolute focus:z-70 focus:m-3 focus:bg-accent focus:px-4 focus:py-2 focus:text-paper">
      <%= t("nav.ir_al_contenido") %>
    </a>

    <%= render "shared/topbar" %>

    <main id="contenido">
      <%= yield %>
    </main>

    <%= render "shared/footer" %>
  </body>
</html>
