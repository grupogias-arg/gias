<footer class="mt-20 border-t border-hairline bg-paper-2/60">
  <div class="wrap py-10">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      <div>
        <%# Marca completa y legible, como pide el manual (p.10). La barra de
            arriba muestra solo la síntesis en celular. %>
        <%= image_tag "logo.png", alt: t("site.name"), width: 1285, height: 602,
                      loading: "lazy", class: "h-[52px] w-auto" %>
      </div>

      <div class="text-[13px] text-ink-soft">
        <p class="lbl mb-2"><%= t("equipo.sedes") %></p>
        <p><%= t("contacto.sede_cerzos") %></p>
        <p class="mt-1"><%= t("contacto.sede_agro") %></p>
      </div>

      <div class="text-[13px]">
        <p class="lbl mb-2"><%= t("novedades.feed") %></p>
        <%= link_to t("novedades.feed"), posts_path(format: :rss), class: "text-accent hover:underline", **new_tab %>
      </div>
    </div>

    <p class="mt-8 font-mono text-[10px] uppercase tracking-[0.12em] text-ink-soft">
      <%= t("site.institution") %>
    </p>
  </div>
</footer>
