<%# Encabezado de las páginas internas (no de la home). %>
<header class="border-b border-hairline bg-paper-2/50">
  <div class="wrap py-12 sm:py-16">
    <p class="lbl"><%= label %></p>
    <h1 class="mt-2 font-serif text-[32px] font-light leading-[1.08] tracking-[-0.02em] sm:text-[44px]">
      <%= title %>
    </h1>
    <% if local_assigns[:subtitle].present? %>
      <p class="mt-3 max-w-[58ch] text-ink-soft"><%= subtitle %></p>
    <% end %>
  </div>
</header>
