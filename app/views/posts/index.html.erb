<% content_for :title, t("novedades.title") %>
<% content_for :description, t("novedades.subtitle") %>

<%= render "shared/page_header",
           label: t("nav.novedades"),
           title: t("novedades.title"),
           subtitle: t("novedades.subtitle") %>

<div class="wrap py-10 sm:py-14">
  <% if @posts.any? %>
    <%= render @posts %>
  <% else %>
    <%= render "shared/empty", message: t("novedades.sin_publicar") %>
  <% end %>
</div>
