<%# Tarjeta de novedad, para la home y para el índice. %>
<article class="border-t border-hairline py-6 first:border-t-0 sm:first:border-t sm:py-7">
  <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:gap-6">
    <p class="shrink-0 font-mono text-[11px] tracking-[0.08em] text-ink-soft sm:w-32">
      <%= long_date(post.published_at) %>
    </p>

    <div class="min-w-0">
      <p class="lbl"><%= enum_label(post, :kind) %></p>

      <h3 class="mt-1 font-serif text-[21px] font-light leading-snug tracking-[-0.012em] sm:text-[23px]">
        <%= link_to post.localized_title, post_path(slug: post), class: "hover:text-accent", **new_tab %>
      </h3>

      <% if post.localized_excerpt.present? %>
        <p class="mt-2 max-w-[62ch] text-[15px] text-ink-soft"><%= post.localized_excerpt %></p>
      <% end %>

      <%= link_to t("novedades.leer"), post_path(slug: post),
                  class: "mt-3 inline-block font-mono text-[10.5px] uppercase tracking-[0.11em] text-accent hover:underline",
                  **new_tab %>
    </div>
  </div>
</article>
