# Secretos que Kamal pasa al servidor. Este archivo se versiona, así que acá no
# va ningún valor: todo sale de config/master.key y de las credentials
# encriptadas (bin/rails credentials:edit). Ver docs/deploy.md.

RAILS_MASTER_KEY=$(cat config/master.key)

GIAS_DATABASE_PASSWORD=$(bin/rails credentials:fetch database_password)
POSTGRES_PASSWORD=$GIAS_DATABASE_PASSWORD
